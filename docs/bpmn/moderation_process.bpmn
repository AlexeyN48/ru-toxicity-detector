        <di:waypoint x="650" y="305" />
        <di:waypoint x="700" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Note_Model_assoc_di" bpmnElement="Note_Model_assoc">
        <di:waypoint x="450" y="495" />
        <di:waypoint x="380" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Note_Error_assoc_di" bpmnElement="Note_Error_assoc">
        <di:waypoint x="600" y="265" />
        <di:waypoint x="560" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Note_Complaint_assoc_di" bpmnElement="Note_Complaint_assoc">
