<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Moderation" targetNamespace="https://github.com/ru-toxicity-detector" exporter="ru-toxicity-detector" exporterVersion="1.0">
  <bpmn:error id="Error_ModelFailure" name="Ошибка модели" errorCode="MODEL_ERROR" />
  <bpmn:collaboration id="Collaboration_Moderation">
    <bpmn:participant id="Participant_Moderation" name="01. Эксплуатация модели: модерация комментариев" processRef="Process_Moderation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Moderation" name="Модерация комментариев" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Moderation">
      <bpmn:lane id="Lane_User" name="Пользователи">
        <bpmn:flowNodeRef>Start_Comment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Complaint</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform" name="Платформа (сервис комментариев)">
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Delete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Model" name="Модель ru-toxicity-detector">
        <bpmn:flowNodeRef>Call_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error_Model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Labeled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Moderator" name="Модератор">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Escalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Comment" name="Пользователь отправил комментарий">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Comment_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Publish" name="Опубликовать комментарий">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Call_Score" name="Оценить токсичность" calledElement="Process_Scoring">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Error_Model" name="Ошибка модели" cancelActivity="true" attachedToRef="Call_Score">
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Error_Model_def" errorRef="Error_ModelFailure" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_Alert" name="Уведомить MLOps">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gw_Threshold" name="Вероятность ≥ порога?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NoCheck" name="Комментарий остаётся опубликованным">
      <bpmn:incoming>Flow_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Complaint" name="Жалоба пользователя на комментарий">
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Complaint_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Queue" name="В очередь модерации">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Review" name="Проверить комментарий">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_SLA" name="SLA 2 ч" cancelActivity="false" attachedToRef="Task_Review">
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_SLA_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_Escalate" name="Эскалировать старшему модератору">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Escalated" name="Старший модератор уведомлён">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Decision" name="Нарушает правила?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Delete" name="Удалить комментарий">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Notify" name="Уведомить автора">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_SaveLabel" name="Сохранить решение как разметку">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Labeled" name="Разметка ушла в retraining-цикл (ДЗ 2)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Comment" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Publish" targetRef="Call_Score" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Call_Score" targetRef="Gw_Threshold" />
    <bpmn:sequenceFlow id="Flow_04" name="да" sourceRef="Gw_Threshold" targetRef="Task_Queue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${p_toxic &gt;= threshold}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" name="нет" sourceRef="Gw_Threshold" targetRef="End_NoCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${p_toxic &lt; threshold}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Start_Complaint" targetRef="Task_Queue" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Queue" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Review" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Timer_SLA" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Escalate" targetRef="End_Escalated" />
    <bpmn:sequenceFlow id="Flow_11" name="да" sourceRef="Gw_Decision" targetRef="Task_Delete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${violation}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Delete" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Notify" targetRef="Task_SaveLabel" />
    <bpmn:sequenceFlow id="Flow_14" name="нет" sourceRef="Gw_Decision" targetRef="Task_SaveLabel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!violation}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SaveLabel" targetRef="End_Labeled" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Error_Model" targetRef="Task_Alert" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Alert" targetRef="Task_Queue" />
    <bpmn:textAnnotation id="Note_Model">
      <bpmn:text>Модель ничего не удаляет сама: только оценивает вероятность. Порог подобран на validation под Recall ≥ 0.85. Что внутри — схема 02</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_Model_assoc" associationDirection="None" sourceRef="Call_Score" targetRef="Note_Model" />
    <bpmn:textAnnotation id="Note_Error">
      <bpmn:text>Безопасный отказ: если модель сломалась, комментарий всё равно проверяет человек</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_Error_assoc" associationDirection="None" sourceRef="Task_Alert" targetRef="Note_Error" />
    <bpmn:textAnnotation id="Note_Complaint">
      <bpmn:text>Жалобы ловят то, что модель пропустила</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_Complaint_assoc" associationDirection="None" sourceRef="Start_Complaint" targetRef="Note_Complaint" />
    <bpmn:textAnnotation id="Note_Labels">
      <bpmn:text>Решения модераторов — свежая разметка для retraining-цикла (ДЗ 2)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_Labels_assoc" associationDirection="None" sourceRef="Task_SaveLabel" targetRef="Note_Labels" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Moderation">
    <bpmndi:BPMNPlane id="Plane_Moderation" bpmnElement="Collaboration_Moderation">
      <bpmndi:BPMNShape id="Participant_Moderation_di" bpmnElement="Participant_Moderation" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1710" height="710" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1680" height="150" />
